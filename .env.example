NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BFF_AUTH_SECRET=replace-with-a-different-32-character-secret
BACKEND_SERVICE_TOKEN_SECRET=replace-with-a-32-character-secret
INSTANCE_FLAG_SECRET=replace-with-a-third-32-character-secret
SERVICE_TOKEN_ISSUER=cyber-range-frontend
SERVICE_TOKEN_AUDIENCE=cyber-range-backend
SIGNUPS_OPEN=false
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
SUBMISSION_RATE_LIMIT_MAX=20
SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
INSTANCE_RATE_LIMIT_MAX=5
INSTANCE_RATE_LIMIT_WINDOW_MS=60000

# Local Compose only. Generate a separate random value; never reuse a real password.
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_PORT=5432
DEV_REDIS_PORT=6379

# Required by the API and database commands.
# Local shape: postgresql://cyber_range:<password>@127.0.0.1:5432/cyber_range
DATABASE_URL=

# Required only by `npm run db:seed`. Use unique development credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=
SEED_PLAYER_EMAIL=
SEED_PLAYER_PASSWORD=
SEED_PLAYER_DISPLAY_NAME=
LOCAL_MAIL_DIRECTORY=.local-mail
# Opt-in Gmail delivery for local demos only; production email remains a launch gate.
MAIL_PROVIDER=local
# Set MAIL_PROVIDER=gmail and provide these server-only values for Gmail.
# SMTP_USER=sender@gmail.com
# SMTP_APP_PASSWORD=your-app-password
EMAIL_SENDER_NAME=Cyber Range
# Production delivery: set MAIL_PROVIDER=resend, use a verified sending domain,
# and set FRONTEND_ORIGIN to the deployed public HTTPS frontend origin.
# RESEND_API_KEY=your-server-only-api-key
# EMAIL_FROM=noreply@your-verified-domain.example

REDIS_URL=redis://localhost:6379

# Required by the API before it can reveal ready target URLs.
# LAB_PUBLIC_BASE_URL=https://labs.example.test

# Required by `npm run worker` and `npm run worker:preflight`. Keep Docker TLS material outside the repository.
# RUNTIME_MANIFEST_PATH=C:\secure-config\runtime-manifests.json
# How routes reach Traefik: `file` writes beside the worker (single disposable host),
# `ingress` delivers them into the ingress container over the worker's Docker connection.
# Production requires `ingress` because ingress runs on the separate target host.
# TRAEFIK_ROUTE_DELIVERY=file
# Required for `file` delivery only.
# TRAEFIK_DYNAMIC_DIRECTORY=C:\secure-config\traefik-dynamic
# Route directory inside ingress. Required for `ingress` delivery; with `file`
# delivery it enables the startup visibility probe.
# TRAEFIK_CONTAINER_DYNAMIC_DIRECTORY=/etc/traefik/dynamic
# LAB_INGRESS_CONTAINER=traefik
# LAB_NODE_NAME=local-lab-node
# Development only; production rejects local Docker sockets.
# DOCKER_SOCKET_PATH=//./pipe/docker_engine
# Production alternative: all four remote mTLS values are required together.
# DOCKER_HOST=https://lab-node.example.test:2376
# DOCKER_CA_PATH=C:\run\secrets\docker-ca.pem
# DOCKER_CLIENT_CERT_PATH=C:\run\secrets\docker-cert.pem
# DOCKER_KEY_PATH=C:\run\secrets\docker-key.pem
